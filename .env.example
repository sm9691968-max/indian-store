# Copy to .env and fill in. Values here are safe development defaults.

# development | testing | production
APP_ENV=development

# Required in production. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-secret-change-me-in-production

# SQLAlchemy URL. Defaults to a SQLite file under instance/.
DATABASE_URL=sqlite:///instance/shop.db

# Set to 1 only when serving over real HTTPS so cookies carry the Secure flag.
COOKIE_SECURE=0

# Flask debug server + reloader. Never 1 in production.
FLASK_DEBUG=0

# Dev server bind address (run.py).
HOST=127.0.0.1
PORT=5000

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
